# Database (Neon PostgreSQL)
# Pooled connection for the app, direct for migrations
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
DIRECT_DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Cloudinary (image hosting)
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Admin panel password (no fallback, required)
ADMIN_PASSWORD="change-me"

# WhatsApp number for orders (digits only, country code included, no +)
WHATSAPP_NUMBER="000000000000"